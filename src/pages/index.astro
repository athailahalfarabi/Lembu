---
// src/pages/index.astro
import Layout    from '../layouts/layout.astro';
import TopBar    from '../components/topBar.astro';
import Navbar    from '../components/navbar.astro';
import Hero      from '../components/hero.astro';
import Gallery   from '../components/gallery.astro';
import Tentang   from '../components/tentang.astro';
import Produk    from '../components/produk.astro';
import Layanan   from '../components/layanan.astro';
import PreFooter from '../components/preFooter.astro';
import Footer    from '../components/footer.astro';
import Cart      from '../components/cart.astro';
import '../styles/global.css';
---
<Layout
  title="Lembu Lemu — Daging Segar Premium di Semarang"
  description="Pemotongan kambing & sapi segar halal bersertifikat langsung dari ahlinya di Meteseh, Semarang. Pesan daging premium untuk kebutuhan rumah, acara, dan katering."
  url="https://lembu-five.vercel.app/"
  image="/luogo.jpeg"
>
  <!-- ① Info bar paling atas -->
  <TopBar />

  <!-- ② Sticky navbar -->
  <Navbar />

  <!-- ③ Halaman utama -->
  <main>
    <Hero />
    <Gallery />
    <Tentang />
    <Produk />
    <Layanan />
  </main>

  <!-- ④ Sebelum footer: social | logo besar | subscribe -->
  <PreFooter />

  <!-- ⑤ Footer + form kontak -->
  <Footer />

  <!-- ⑥ Keranjang belanja (overlay + sidebar) -->
  <Cart />

  <!-- ⑦ Tombol kembali ke atas -->
  <button class="back-top" id="back-top" aria-label="Kembali ke atas">
    <svg viewBox="0 0 24 24">
      <polyline points="18 15 12 9 6 15"
        fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
    </svg>
  </button>

  <!-- ⑧ Semua JavaScript -->
  <script src="/scripts/main.js" defer></script>
</Layout>