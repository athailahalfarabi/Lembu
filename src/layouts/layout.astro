---
interface Props {
  title?: string;
  description?: string;
}
const {
  title       = 'Lembu Lemu — Daging Segar Premium',
  description = 'Pemotongan daging kambing & sapi segar, halal bersertifikat, langsung dari tangan ahlinya. Meteseh, Semarang.',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml"
    href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🥩</text></svg>"
  />
</head>
<body>
  <slot />
</body>
</html>