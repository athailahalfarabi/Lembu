---
import Seo from '../components/Seo.astro';

interface Props {
  title?: string;
  description?: string;
  url?: string;
  image?: string;
}
const {
  title       = 'Lembu Lemu | Supplier Daging Sapi Segar & Halal di Kecamatan Tlogomulyo Kabupaten Temanggung Jawa Tengah',
  description = 'Mencari daging segar berkualitas? Lembu Lemu menyediakan daging halal untuk sapi dan kambing di Kecamatan Tlogomulyo, Kabupaten Temanggung, Jawa Tengah. Hubungi kami untuk kebutuhan bisnis & aqiqah',
  url         = 'https://lembu-five.vercel.app/',
  image       = 'https://lembu-five.vercel.app/luogo.jpeg',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <Seo
    title={title}
    description={description}
    url={url}
    image={image}
  />
  <link rel="icon" href="/logo.png" type="image/png" />
  <style>
    body {
      margin: 0;
      overflow: hidden;
      min-height: 100vh;
    }
    body.splash-active {
      overflow: hidden;
    }
    #splash-screen {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 1;
      visibility: visible;
      background: #000;
    }
  </style>
</head>
<body class="splash-active">
  <div id="splash-screen" class="splash-screen" aria-hidden="true">
    <div class="splash-content">
      <div class="splash-logo">
        <img src="/luogo.jpeg" alt="Lembu Lemu" class="splash-logo-img" />
      </div>
    </div>
  </div>

  <slot />
</body>
</html>