---
// src/components/Tentang.astro
const features = [
  {
    num: '01',
    title: 'Harga Lebih Terjangkau',
    desc: 'karena seluruh rantai produksi mulai dari ternak-sembelih-distribusi dikelola sendiri.',
  },
  {
    num: '02',
    title: 'Potong Setiap Hari',
    desc: 'Sehingga stok selalu segar dan stabil.',
  },
  {
    num: '03',
    title: 'Pengiriman Cepat',
    desc: 'Menjangkau area Temanggung - Magelang - Semarang - Yogyakarta.',
  },
  {
    num: '04',
    title: 'Frash & Halal',
    desc: 'NON-OPLOS,NON CAMPUR',
  },
  {
    num: '05',
    title: 'Murah & Berkualitas',
    desc: 'Lebih murah dari pada harga dipasaran',
  }
];
---

<section id="tentang">
  <div class="about-grid">
    <!-- Kiri: judul & deskripsi -->
    <div class="about-left">
      <p class="section-label"> — Tentang Kami</p>
      <h2 class="about-title">
        Bukan<br/>
        Sembarang<br/>
        <em>Jagal</em>
      </h2>
      <div class="about-line"></div>
      <p class="about-body">
        Lembu Lemu menyediakan dan mendistribusikan daging sapi lokal berkualitas 
    melalui sistem produksi terintegrasi, memastikan produk selalu segar, 
    higienis, halal, dan stabil.
      </p>
    </div>

    <!-- Kanan: feature list -->
    <div class="about-right">
      {features.map((f) => (
        <div class="feat-row">
          <div class="feat-num">{f.num}</div>
          <div>
            <div class="feat-title">{f.title}</div>
            <div class="feat-desc">{f.desc}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>