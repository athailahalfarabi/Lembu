---
// src/components/gallery.astro
// Galeri media (foto dan video) di antara hero dan tentang
---

<section id="galeri" class="gallery-section">
  <div class="gallery-container">
    <!-- Header -->
    <div class="gallery-header">
      <p class="section-label">— Galeri Kami</p>
      <h2 class="gallery-title">Lihat Proses & Produk Kami</h2>
    </div>

    <!-- Grid galeri -->
    <div class="gallery-wrapper">
      <button class="gallery-nav gallery-prev" aria-label="Previous">&larr;</button>
      <div class="gallery-grid">
        <!-- Item 1: Video -->
        <div class="gallery-item video">
          <div class="gallery-media">
            <iframe 
              width="100%" 
              height="100%" 
              src="https://www.youtube.com/embed/WrOzwoMKzH4?si=AyaPnGvI8gd_80lw"
              title="Video Produksi Daging Segar" 
              frameborder="0" 
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
              allowfullscreen>
            </iframe>
          </div>
        </div>

        <!-- Item 2: Foto -->
        <div class="gallery-item photo">
          <div class="gallery-media">
            <img 
              src="/kualtitas.jpg" 
              alt="Daging Segar Berkualitas" 
              loading="lazy"
            />
          </div>
        </div>

        <!-- Item 3: Foto -->
        <div class="gallery-item photo">
          <div class="gallery-media">
            <img 
              src="/pemotongan.jpg" 
              alt="Proses Pemotongan Daging" 
              loading="lazy"
            />
          </div>
        </div>

        <!-- Item 4: Video -->
        <div class="gallery-item video">
          <div class="gallery-media">
            <iframe 
              width="100%" 
              height="100%" 
              src="https://www.youtube.com/embed/jLjP9xVJx-8?si=h7wIh03BcHm1OU_Q"  
              title="Video Sertifikasi Halal" 
              frameborder="0" 
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
              allowfullscreen>
            </iframe>
          </div>
        </div>

        <!-- Item 5: Foto -->
        <div class="gallery-item photo">
          <div class="gallery-media">
            <img 
              src="/kemasan.jpg" 
              alt="Kemasan Produk Daging" 
              loading="lazy"
            />
          </div>
        </div>

        <!-- Item 6: Foto -->
        <div class="gallery-item photo">
          <div class="gallery-media">
            <img 
              src="/tim.jpg" 
              alt="Tim Lembu Lemu" 
              loading="lazy"
            />
          </div>
        </div>
      </div>
      <button class="gallery-nav gallery-next" aria-label="Next">&rarr;</button>
    </div>
  </div>
</section>

<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
  const galleryGrid = document.querySelector('.gallery-grid');
  const prevBtn = document.querySelector('.gallery-prev');
  const nextBtn = document.querySelector('.gallery-next');
  const items = document.querySelectorAll('.gallery-item');

  if (!galleryGrid || !prevBtn || !nextBtn || items.length === 0) return;

  let currentIndex = 0;

  function updateButtons() {
    prevBtn.style.opacity = currentIndex === 0 ? '0.5' : '1';
    nextBtn.style.opacity = currentIndex === items.length - 1 ? '0.5' : '1';
  }

  function scrollToItem(index) {
    const item = items[index];
    if (item) {
      item.scrollIntoView({
        behavior: 'smooth',
        block: 'nearest',
        inline: 'start'
      });
      currentIndex = index;
      updateButtons();
    }
  }

  prevBtn.addEventListener('click', () => {
    if (currentIndex > 0) {
      scrollToItem(currentIndex - 1);
    }
  });

  nextBtn.addEventListener('click', () => {
    if (currentIndex < items.length - 1) {
      scrollToItem(currentIndex + 1);
    }
  });

  // Update currentIndex on scroll
  galleryGrid.addEventListener('scroll', () => {
    const scrollLeft = galleryGrid.scrollLeft;
    const itemWidth = items[0].offsetWidth + 24; // 24px gap
    currentIndex = Math.round(scrollLeft / itemWidth);
    updateButtons();
  });

  updateButtons();
});
</script>