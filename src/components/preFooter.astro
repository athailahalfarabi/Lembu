---
// src/components/PreFooter.astro
---
<div class="pre-footer">

  <!-- Kiri: social icons -->
  <div class="pf-col">
    <p class="pf-label">Ikuti Kami</p>
    <div class="pf-socials">
      <a href="#" class="pf-social" aria-label="Facebook" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
        </svg>
      </a>
      <a href="#" class="pf-social" aria-label="Instagram" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
        </svg>
      </a>
      <a href="#" class="pf-social" aria-label="X (Twitter)" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
      </a>
    </div>
    <p class="pf-label" style="margin-top:0.5rem;font-size:0.52rem">Update &amp; promo terbaru</p>
  </div>

  <!-- Tengah: logo besar -->
  <div class="pf-col">
    <div class="pf-logo-big">
      
      <div class="pf-logo-img">
  <img src="/logo.png" alt="Lembu lemu" />
</div>
      <div class="pf-logo-name">LEMBU LEMU</div>
      <div class="pf-logo-tagline">Daging segar dari tangan yang tepat</div>
    </div>
  </div>

  <!-- Kanan: subscribe email -->
  <div class="pf-col">
    <div class="subscribe-form">
      <div class="subscribe-title">Berlangganan</div>
      <div class="subscribe-desc">
        Dapatkan info harga terbaru, promo, dan ketersediaan stok
        langsung ke email Anda.
      </div>
      <input
        type="email"
        class="subscribe-input"
        id="subscribe-email"
        placeholder="email@anda.com"
        aria-label="Alamat email"
      />
      <button class="subscribe-btn" id="subscribe-btn">Daftar Sekarang</button>
    </div>
  </div>

</div>