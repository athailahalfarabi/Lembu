---
const services = [
  {
    num: '01',
    name: 'Potong Custom',
    body: 'Dadu, fillet, slice tipis, boneless, atau karkas utuh. Kami potong sesuai kebutuhan dapur Anda tanpa biaya ekstra.',
    
  },
  {
    num: '02',
    name: 'Antar Gratis',
    body: 'Gratis ongkir area Tlogomulyo & sekitarnya untuk pembelian minimal 5kg. Pengiriman subuh tersedia untuk kebutuhan katering.',
    
  },
  {
    num: '03',
    name: 'Paket Katering',
    body: 'Harga khusus untuk pembelian volume besar. Cocok untuk katering, warung, rumah makan, dan restoran.',
    
  },
  {
    num: '04',
    name: 'Paket Aqiqah',
    body: 'Layanan lengkap aqiqah: pemilihan hewan, penyembelihan sesuai syariat, pemotongan, hingga distribusi ke penerima.',
    
  },
  {
    num: '05',
    name: 'Paket Kurban',
    body: 'Terima order kurban jauh hari. Kami tangani dari hewan pilihan, pemotongan halal, pengemasan, sampai distribusi.',
    
  },
  {
    num: '06',
    name: 'Langganan Bulanan',
    body: 'Daftar sebagai pelanggan tetap dan nikmati diskon 10%, prioritas stok, dan notifikasi menu terbaru via WhatsApp.',
    
  },
];
---
<section id="layanan">
  <div class="layanan-header">
    <h2 class="layanan-title">
      LAYANAN<br/>
      <em>KAMI</em>
    </h2>
    <p class="layanan-desc">Lebih dari sekadar beli daging — kami mitra dapur Anda</p>
  </div>

  <div class="layanan-grid">
    {services.map((s) => (
      <div class="layanan-card">
        <div class="layanan-num">{s.num}</div>
        <div class="layanan-name">{s.name}</div>
        <div class="layanan-body">{s.body}</div>
      </div>
    ))}
  </div>
</section>